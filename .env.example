# ─────────────────────────────────────────────────────────────
# MJ Gestão & Ambiental — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o .env.local.
# ─────────────────────────────────────────────────────────────

# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Supabase (Project Settings → API). A "anon key" é pública por design;
# a proteção dos dados é feita pelas políticas RLS das migrações.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Força o modo demonstrativo (dados no navegador) mesmo com Supabase configurado.
# Deixe vazio ou "false" em produção.
NEXT_PUBLIC_DEMO_MODE=

# Somente para o build do GitHub Pages (definidos pelo workflow).
# NEXT_PUBLIC_STATIC_EXPORT=true
# NEXT_PUBLIC_BASE_PATH=/nome-do-repositorio

# ── Somente servidor (nunca use o prefixo NEXT_PUBLIC_) ──────
# Segredo para gerar o hash de IP usado no limite de envios.
RATE_LIMIT_SALT=troque-por-um-valor-aleatorio-longo

# Notificação por e-mail de novas solicitações (opcional — Resend)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
